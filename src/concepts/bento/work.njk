---
permalink: /concepts/bento/work.html
station: work
seoTitle: "Radio Ad Examples, Radio Commercial Scripts | Overnight Radio Inc."
seoDescription: "A sample of Overnight Radio spots that were created from start to finish, in a broad range of styles (Hardsell, Medium, Softsell & Creative)."
---
<section class="wrap pagehead reveal">
  <p class="eyebrow">Our Work</p>
  <h1 class="display display--page">Our Work, <i>Our Pride</i></h1>
  <p class="lede lede--page">Overnight Radio has produced tens of thousands of top radio commercials from start to finish, covering a broad range of advertising styles from Hardsell, Medium, Softsell to Creative. Listen to some of the radio ad examples that we have produced. All made each client very happy.</p>
</section>
<section class="wrap">
  <div class="seg seg--wide" role="toolbar" aria-label="Filter by style" data-filters>
    {% for f in ["all", "Hardsell", "Medium", "Softsell", "Creative", "Sample"] %}
    <button type="button" class="{% if f == 'all' %}is-active is-on{% endif %}" data-filter="{{ f }}" aria-pressed="{{ 'true' if f == 'all' else 'false' }}">{{ "Show All" if f == "all" else f }}</button>
    {% endfor %}
  </div>
  <ul class="cards" data-spots>
    {% for s in collections.spots %}
    <li class="spot voice card card--{{ s.data.category | lower }}" data-category="{{ s.data.category }}">
      <a class="card__link" href="{{ cbase }}{{ s.url }}">
        <span class="chip">{{ s.data.category }}</span>
        <span class="card__title">{{ s.data.title }}</span>
        <span class="card__more">Script &amp; details <svg aria-hidden="true"><use href="#i-arrow-right"/></svg></span>
      </a>
      <button class="voice__play card__play" type="button" data-quickplay="{{ s.data.spotMp3 | asset }}" aria-label="Play the {{ s.data.title }} spot"><svg class="i-play" aria-hidden="true"><use href="#i-play"/></svg><svg class="i-pause" aria-hidden="true"><use href="#i-pause"/></svg></button>
    </li>
    {% endfor %}
  </ul>
</section>
<section class="wrap section-head reveal"><h2 class="h2">What our <i>Clients</i> say</h2></section>
<section class="wrap bento bento--quotes">
  {% for t in testimonials %}
  <figure class="tile quote reveal{% if t.featured %} tile--dark quote--big{% endif %}"><blockquote>“{{ t.quote }}”</blockquote>{% if t.name %}<figcaption>{{ t.name }}</figcaption>{% endif %}</figure>
  {% endfor %}
</section>

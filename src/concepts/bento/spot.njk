---
pagination:
  data: collections.spots
  size: 1
  alias: s
permalink: "/concepts/bento/work/{{ s.fileSlug }}.html"
station: work
eleventyComputed:
  seoTitle: "{{ s.data.seoTitle | safe }}"
  seoDescription: "{{ s.data.seoDescription | safe }}"
---
<section class="wrap pagehead reveal">
  <a class="back" href="{{ cbase }}/work.html"><svg aria-hidden="true"><use href="#i-arrow-left"/></svg> Our Work</a>
  <p class="eyebrow">{{ s.data.category }}</p>
  <h1 class="display display--page">{{ s.data.title }}</h1>
</section>
<section class="wrap bento bento--detail">
  <article class="tile tile--dark tile--sticky reveal">
    {% set p = { mp3: s.data.spotMp3, ogg: s.data.spotOgg, label: s.data.title + " · " + s.data.category } %}
    {% include "concepts/bento/player.njk" %}
  </article>
  {% if s.content | trim %}
  <article class="tile script reveal">
    <p class="eyebrow">Script</p>
    {{ s.content | replace("</strong>: ", "</strong> ") | replace("</strong>:", "</strong> ") | safe }}
  </article>
  {% endif %}
</section>

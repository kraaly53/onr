---
pagination:
  data: collections.posts
  size: 5
  alias: pagePosts
permalink: "{% if pagination.pageNumber == 0 %}/concepts/bento/blog/index.html{% else %}/concepts/bento/blog/page/{{ pagination.pageNumber + 1 }}/index.html{% endif %}"
station: blog
eleventyComputed:
  seoTitle: "Blog{% if pagination.pageNumber > 0 %} - Page {{ pagination.pageNumber + 1 }}{% endif %} | Overnight Radio Inc."
---
<section class="wrap pagehead reveal">
  <p class="eyebrow">Blog</p>
  <h1 class="display display--page">The Overnight Radio <i>Blog</i></h1>
  <p class="lede lede--page">We will be discussing issues relevant to the world of radio production and scripting.</p>
</section>
<section class="wrap posts">
  {% for post in pagePosts %}
  <a class="tile post reveal{% if loop.first and pagination.pageNumber == 0 %} post--lead tile--dark{% endif %}" href="{{ cbase }}{{ post.url }}">
    <span class="post__meta"><time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>{% for c in post.data.categories %}<span class="chip chip--sm">{{ c }}</span>{% endfor %}</span>
    <span class="post__title">{{ post.data.title }}</span>
    <span class="post__excerpt">{{ post.content | excerpt(32) }}</span>
    <span class="tile__foot">Continue reading <svg aria-hidden="true"><use href="#i-arrow-right"/></svg></span>
  </a>
  {% endfor %}
</section>
<nav class="wrap pager" aria-label="Blog pages">
  {% if pagination.href.previous %}<a class="btn btn--ghost" href="{{ pagination.href.previous }}" rel="prev"><svg aria-hidden="true"><use href="#i-arrow-left"/></svg> Newer posts</a>{% else %}<span></span>{% endif %}
  <span class="muted mono">Page {{ pagination.pageNumber + 1 }} of {{ pagination.pages.length }}</span>
  {% if pagination.href.next %}<a class="btn btn--accent" href="{{ pagination.href.next }}" rel="next">Older posts <svg aria-hidden="true"><use href="#i-arrow-right"/></svg></a>{% else %}<span></span>{% endif %}
</nav>

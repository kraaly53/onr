---
pagination:
  data: collections.team
  size: 1
  alias: m
permalink: "/concepts/bento/team/{{ m.fileSlug }}.html"
station: team
eleventyComputed:
  seoTitle: "{{ m.data.seoTitle | safe }}"
  seoDescription: "{{ m.data.seoDescription | safe }}"
---
{%- set prev = collections.team | getPreviousCollectionItem(m) -%}
{%- set next = collections.team | getNextCollectionItem(m) -%}
<section class="wrap pagehead pagehead--tight reveal">
  <a class="back" href="{{ cbase }}/team.html"><svg aria-hidden="true"><use href="#i-arrow-left"/></svg> Team</a>
</section>
<section class="wrap bento bento--profile">
  <figure class="tile tile--photo reveal"><img src="{{ m.data.photo | asset }}" alt="{{ m.data.name }}"></figure>
  <article class="tile tile--span2 reveal">
    <span class="chip">{{ m.data.role or "Announcer" }}</span>
    <h1 class="display display--name">{{ m.data.name }}</h1>
    <div class="bio">{{ m.content | safe }}</div>
  </article>
  <article class="tile tile--dark tile--span2 reveal">
    {% set p = { mp3: m.data.sampleMp3, ogg: m.data.sampleOgg, label: m.data.sampleLabel } %}
    {% include "concepts/bento/player.njk" %}
  </article>
  <nav class="tile tile--nav reveal" aria-label="More voices">
    {% if prev %}<a href="{{ cbase }}{{ prev.url }}"><small>Previous</small>{{ prev.data.cardName or prev.data.name }}</a>{% endif %}
    {% if next %}<a href="{{ cbase }}{{ next.url }}"><small>Next</small>{{ next.data.cardName or next.data.name }} <svg aria-hidden="true"><use href="#i-arrow-right"/></svg></a>{% endif %}
  </nav>
</section>

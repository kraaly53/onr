---
permalink: /concepts/bento/calculator.html
station: calculator
seoTitle: "Commercial Script Calculator | Overnight Radio Inc."
seoDescription: "Commerical Script Calculator that will calcuate the timing of the commercial."
scripts: ["/assets/js/calculator.js"]
---
<section class="wrap pagehead reveal">
  <p class="eyebrow">Script Calculator</p>
  <h1 class="display display--page">Commercial <i>Script Calculator</i></h1>
  <p class="lede lede--page">Enter your script, select the read speed, click the button and we'll tell you how long you commercial will be.</p>
</section>
<form class="wrap bento bento--calc" onsubmit="return false">
  <label class="tile tile--span2 field reveal"><span class="eyebrow">Script</span><textarea name="message" id="message" rows="10" placeholder="Enter script here" autofocus></textarea></label>
  <div class="tile tile--dark reveal calc-out">
    <p class="eyebrow eyebrow--light">Total Script Length</p>
    <output class="stat stat--light" id="wlength" name="wlength">0</output>
    <p class="eyebrow eyebrow--light">Word Count</p>
    <output class="stat stat--light stat--sm" id="wcount" name="wcount">0</output>
  </div>
  <div class="tile tile--span3 calc-bar reveal">
    <label class="field field--inline"><span class="eyebrow">Script Read Speed</span>
      <select id="speed" name="speed"><option value="1">Slow Read</option><option value="2" selected>Normal Read</option><option value="3">Fast Read</option></select>
    </label>
    <button type="button" class="btn btn--accent" id="calculateScript">Calculate Length <svg aria-hidden="true"><use href="#i-arrow-right"/></svg></button>
  </div>
  <label class="tile tile--span3 field reveal"><span class="eyebrow">Results</span><textarea name="results" id="results" rows="5" placeholder="Results" readonly></textarea></label>
</form>

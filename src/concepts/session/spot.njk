---
pagination:
  data: collections.spots
  size: 1
  alias: s
permalink: "/concepts/session/work/{{ s.fileSlug }}.html"
station: work
eleventyComputed:
  seoTitle: "{{ s.data.seoTitle | safe }}"
  seoDescription: "{{ s.data.seoDescription | safe }}"
---
<nav class="crumbs"><a href="{{ cbase }}/work.html">← Our Work</a><span>/</span><span>{{ s.data.title }}.session</span></nav>
<section class="editor editor--spot">
  <div class="editor__main">
    <p class="clip__label clip__label--plain">{{ s.data.category }}</p>
    <h1 class="headline headline--name">{{ s.data.title }}</h1>
    {% set p = { mp3: s.data.spotMp3, ogg: s.data.spotOgg, label: s.data.title + " · " + s.data.category } %}
    {% include "concepts/session/clip.njk" %}
  </div>
</section>
{% if s.content | trim %}
{# The script, laid out as a multitrack: one lane per speaker, each line a clip in running order. Built by session.js from the plain script below. #}
<section class="multitrack" data-multitrack>
  <div class="multitrack__ruler" aria-hidden="true"></div>
  <div class="multitrack__lanes" data-lanes></div>
  <div class="script-src" data-script>{{ s.content | replace("</strong>: ", "</strong> ") | replace("</strong>:", "</strong> ") | safe }}</div>
</section>
{% endif %}

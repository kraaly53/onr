---
pagination:
  data: collections.posts
  size: 5
  alias: pagePosts
permalink: "{% if pagination.pageNumber == 0 %}/concepts/session/blog/index.html{% else %}/concepts/session/blog/page/{{ pagination.pageNumber + 1 }}/index.html{% endif %}"
station: blog
eleventyComputed:
  seoTitle: "Blog{% if pagination.pageNumber > 0 %} - Page {{ pagination.pageNumber + 1 }}{% endif %} | Overnight Radio Inc."
---
<section class="track track--title">
  <div class="track__hdr"><span class="track__n">01</span><span class="track__name">Title</span><span class="ms"><b>M</b><b class="on">S</b></span></div>
  <div class="track__lane"><div class="clip clip--big" style="--c: var(--track)"><span class="clip__label">Blog · Session notes</span><h1 class="headline">The Overnight Radio <span>Blog</span></h1>
    <p class="clip__text">We will be discussing issues relevant to the world of radio production and scripting.</p></div></div>
</section>
{% for post in pagePosts %}
<section class="track">
  <div class="track__hdr"><span class="track__n">{{ (loop.index + 1) | pad2 }}</span><span class="track__name"><time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time></span><span class="ms"><b>M</b><b>S</b></span></div>
  <div class="track__lane">
    <a class="clip clip--post" href="{{ cbase }}{{ post.url }}" style="--c: {{ ['#8e9bff','#5ad1f5','#6ee7a8','#f5c84b','#ff8a3d'][loop.index0] }}">
      <span class="clip__label">{{ post.data.categories | join(" · ") }}</span>
      <span class="post__title">{{ post.data.title }}</span>
      <span class="clip__text">{{ post.content | excerpt(36) }}</span>
      <span class="go">Continue reading →</span>
    </a>
  </div>
</section>
{% endfor %}
<nav class="nudge nudge--blog" aria-label="Blog pages">
  {% if pagination.href.previous %}<a href="{{ pagination.href.previous }}" rel="prev"><small>⏮</small>Newer posts</a>{% else %}<span></span>{% endif %}
  <span class="nudge__count">Page {{ pagination.pageNumber + 1 }} of {{ pagination.pages.length }}</span>
  {% if pagination.href.next %}<a class="nudge__next" href="{{ pagination.href.next }}" rel="next"><small>⏭</small>Older posts</a>{% else %}<span></span>{% endif %}
</nav>

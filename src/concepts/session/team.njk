---
permalink: /concepts/session/team.html
station: team
seoTitle: "Voice Over Artists, Voice Talent Toronto | Overnight Radio Inc."
seoDescription: "Overnight's Staff consists of some of the most professional producers & announcers in the industry today. Bringing you the right voice for your radio ad."
---
<section class="track track--title">
  <div class="track__hdr"><span class="track__n">01</span><span class="track__name">Title</span><span class="ms"><b>M</b><b class="on">S</b></span></div>
  <div class="track__lane"><div class="clip clip--big" style="--c: var(--track)"><span class="clip__label">Team</span><h1 class="headline">Meet the <span>Team</span></h1>
    <p class="clip__text">Overnight's Staff consists of some of the most professional radio producers, male and female voice over artists working in the industry today. All of our voice over talent have major market experience and bring that "big sound" with them. Over the years, Overnight Radio has constantly been looking for the right voices to represent us and you in the best possible way, and we are proud to say that each one of our voice over talents does just that. Click on the name of a team member below to find out more about them, and to hear their commercial voice over sample.</p></div></div>
</section>

<section class="track">
  <div class="track__hdr"><span class="track__n">02</span><span class="track__name">The Production Team</span><span class="ms"><b>M</b><b>S</b></span></div>
  <div class="track__lane track__lane--split">
    {% for m in collections.production %}
    <a class="clip clip--person" href="{{ cbase }}{{ m.url }}" style="--c: {{ ['#ff8a3d', '#f5c84b'][loop.index0] }}">
      <span class="clip__label">{{ m.data.role }}</span>
      <span class="person"><img src="{{ (m.data.cardPhoto or m.data.photo) | asset }}" alt="{{ m.data.name }}" loading="lazy">
        <span><span class="person__name">{{ m.data.cardName or m.data.name }}</span><span class="clip__text">{{ m.data.summary }}</span><span class="go">Bio &amp; {{ m.data.sampleLabel | lower }} →</span></span></span>
    </a>
    {% endfor %}
  </div>
</section>

<section class="mixer-wrap">
  <div class="mixer__top">
    <h2 class="h2">Talent <small>· the mixing desk — press <b>S</b> to solo a voice</small></h2>
    <label class="search"><span class="sr-only">Find a voice</span><input type="search" placeholder="Find a voice" data-team-search autocomplete="off"></label>
  </div>
  <ul class="mixer" data-talent>
    {% for m in collections.talent %}
    <li class="voice strip" data-name="{{ (m.data.cardName or m.data.name) | lower }}">
      <span class="strip__n">{{ loop.index | pad2 }}</span>
      <a class="strip__photo" href="{{ cbase }}{{ m.url }}" tabindex="-1" aria-hidden="true"><img src="{{ (m.data.cardPhoto or m.data.photo) | asset }}" alt="" loading="lazy"></a>
      <span class="strip__meter" aria-hidden="true"><i></i><i></i></span>
      <span class="strip__fader" aria-hidden="true"><i style="--f: {{ 30 + (loop.index * 17) % 50 }}%"></i></span>
      <button class="voice__play strip__solo" type="button" data-quickplay="{{ m.data.sampleMp3 | asset }}" aria-label="Solo: play {{ m.data.cardName or m.data.name }}’s sample"><span class="i-play">S</span><span class="i-pause">S</span></button>
      <a class="strip__name" href="{{ cbase }}{{ m.url }}">{{ m.data.cardName or m.data.name }}</a>
      {% if m.data.roster == "non-roster" %}<span class="strip__tag">Non-roster</span>{% endif %}
    </li>
    {% endfor %}
  </ul>
  <p class="muted" data-team-empty hidden>No voices match that name.</p>
</section>

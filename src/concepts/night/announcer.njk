---
pagination:
  data: collections.team
  size: 1
  alias: m
permalink: "/concepts/night/team/{{ m.fileSlug }}.html"
station: team
hour: 0.6
eleventyComputed:
  seoTitle: "{{ m.data.seoTitle | safe }}"
  seoDescription: "{{ m.data.seoDescription | safe }}"
---
{%- set prev = collections.team | getPreviousCollectionItem(m) -%}
{%- set next = collections.team | getNextCollectionItem(m) -%}
<section class="head head--profile"><div class="wrap">
  <a class="back" href="{{ cbase }}/team.html">← Team</a>
  <div class="profile">
    <div class="moonpic moonpic--xl"><img src="{{ m.data.photo | asset }}" alt="{{ m.data.name }}"></div>
    <div>
      <p class="eyebrow">{{ m.data.role or "Announcer" }}</p>
      <h1 class="mega mega--name">{{ m.data.name }}</h1>
      <div class="prose prose--big">{{ m.content | safe }}</div>
      {% set p = { mp3: m.data.sampleMp3, ogg: m.data.sampleOgg, label: m.data.sampleLabel } %}
      {% include "concepts/night/player.njk" %}
    </div>
  </div>
</div></section>
<nav class="pager wrap" aria-label="More voices">
  {% if prev %}<a href="{{ cbase }}{{ prev.url }}"><small>← Previous</small>{{ prev.data.cardName or prev.data.name }}</a>{% else %}<span></span>{% endif %}
  <a class="pager__all" href="{{ cbase }}/team.html">All voices</a>
  {% if next %}<a class="pager__next" href="{{ cbase }}{{ next.url }}"><small>Next →</small>{{ next.data.cardName or next.data.name }}</a>{% else %}<span></span>{% endif %}
</nav>

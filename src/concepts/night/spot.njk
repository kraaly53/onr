---
pagination:
  data: collections.spots
  size: 1
  alias: s
permalink: "/concepts/night/work/{{ s.fileSlug }}.html"
station: work
hour: 0.36
eleventyComputed:
  seoTitle: "{{ s.data.seoTitle | safe }}"
  seoDescription: "{{ s.data.seoDescription | safe }}"
---
<section class="head"><div class="wrap wrap--narrow">
  <a class="back" href="{{ cbase }}/work.html">← Our Work</a>
  <p class="eyebrow">{{ s.data.category }}</p>
  <h1 class="mega mega--name">{{ s.data.title }}</h1>
  {% set p = { mp3: s.data.spotMp3, ogg: s.data.spotOgg, label: s.data.title + " · " + s.data.category } %}
  {% include "concepts/night/player.njk" %}
</div></section>
{% if s.content | trim %}
<section class="band"><div class="wrap wrap--narrow">
  <div class="glass script">{{ s.content | replace("</strong>: ", "</strong> ") | replace("</strong>:", "</strong> ") | safe }}</div>
</div></section>
{% endif %}

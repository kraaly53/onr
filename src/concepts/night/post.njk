---
pagination:
  data: collections.posts
  size: 1
  alias: post
permalink: "/concepts/night{{ post.url }}index.html"
station: blog
hour: 0.64
eleventyComputed:
  seoTitle: "{{ post.data.title | safe }} | Overnight Radio Inc. Blog"
  seoDescription: "{{ post.data.description | safe }}"
---
{%- set newerPost = collections.posts | getPreviousCollectionItem(post) -%}
{%- set olderPost = collections.posts | getNextCollectionItem(post) -%}
<section class="head"><div class="wrap wrap--narrow">
  <a class="back" href="{{ cbase }}/blog/">← Blog</a>
  <p class="eyebrow"><time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time> · {{ post.data.categories | join(" · ") }}</p>
  <h1 class="mega mega--post">{{ post.data.title }}</h1>
  <p class="soft">By {{ post.data.author or "Overnight Radio" }}</p>
</div></section>
<section class="band"><div class="wrap wrap--narrow"><article class="glass prose prose--big">{{ post.content | safe }}</article></div></section>
<nav class="pager wrap wrap--narrow" aria-label="More posts">
  {% if newerPost %}<a href="{{ cbase }}{{ newerPost.url }}"><small>← Newer post</small>{{ newerPost.data.title }}</a>{% else %}<span></span>{% endif %}
  <a class="pager__all" href="{{ cbase }}/blog/">All posts</a>
  {% if olderPost %}<a class="pager__next" href="{{ cbase }}{{ olderPost.url }}"><small>Older post →</small>{{ olderPost.data.title }}</a>{% else %}<span></span>{% endif %}
</nav>

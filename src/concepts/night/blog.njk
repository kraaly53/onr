---
pagination:
  data: collections.posts
  size: 5
  alias: pagePosts
permalink: "{% if pagination.pageNumber == 0 %}/concepts/night/blog/index.html{% else %}/concepts/night/blog/page/{{ pagination.pageNumber + 1 }}/index.html{% endif %}"
station: blog
hour: 0.66
eleventyComputed:
  seoTitle: "Blog{% if pagination.pageNumber > 0 %} - Page {{ pagination.pageNumber + 1 }}{% endif %} | Overnight Radio Inc."
---
<section class="head"><div class="wrap">
  <p class="stamp-time">Blog</p>
  <h1 class="mega mega--page">The Overnight Radio <span>Blog</span></h1>
  <p class="hero-lede hero-lede--sm">We will be discussing issues relevant to the world of radio production and scripting.</p>
</div></section>
<section class="band"><div class="wrap wrap--narrow">
  {% for post in pagePosts %}
  <article class="glass post">
    <p class="eyebrow"><time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time> · {{ post.data.categories | join(" · ") }}</p>
    <h2 class="post__title"><a href="{{ cbase }}{{ post.url }}">{{ post.data.title }}</a></h2>
    <p class="soft">{{ post.content | excerpt }}</p>
    <a class="textlink" href="{{ cbase }}{{ post.url }}">Continue reading →</a>
  </article>
  {% endfor %}
  <nav class="pager pager--blog" aria-label="Blog pages">
    {% if pagination.href.previous %}<a href="{{ pagination.href.previous }}" rel="prev"><small>←</small>Newer posts</a>{% else %}<span></span>{% endif %}
    <span class="pager__all">Page {{ pagination.pageNumber + 1 }} of {{ pagination.pages.length }}</span>
    {% if pagination.href.next %}<a class="pager__next" href="{{ pagination.href.next }}" rel="next"><small>→</small>Older posts</a>{% else %}<span></span>{% endif %}
  </nav>
</div></section>

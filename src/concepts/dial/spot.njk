---
pagination:
  data: collections.spots
  size: 1
  alias: s
permalink: "/concepts/dial/work/{{ s.fileSlug }}.html"
station: work
eleventyComputed:
  seoTitle: "{{ s.data.seoTitle | safe }}"
  seoDescription: "{{ s.data.seoDescription | safe }}"
---
<section class="station">
  <div class="wrap wrap--narrow">
    <a class="back" href="{{ cbase }}/work.html">← Our Work</a>
    <div class="glass">
      <p class="glass__top"><span>{{ s.data.category }}</span><span class="lamp is-on">On air</span></p>
      <h1 class="glass__name">{{ s.data.title }}</h1>
    </div>
    {% set p = { mp3: s.data.spotMp3, ogg: s.data.spotOgg, label: s.data.title + " · " + s.data.category } %}
    {% include "concepts/dial/player.njk" %}
    {% if s.content | trim %}
    <div class="printout">
      <p class="printout__head">Script · {{ s.data.title }}</p>
      <div class="printout__body">{{ s.content | replace("</strong>: ", "</strong> ") | replace("</strong>:", "</strong> ") | safe }}</div>
    </div>
    {% endif %}
  </div>
</section>

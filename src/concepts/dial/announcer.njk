---
pagination:
  data: collections.team
  size: 1
  alias: m
permalink: "/concepts/dial/team/{{ m.fileSlug }}.html"
station: team
eleventyComputed:
  seoTitle: "{{ m.data.seoTitle | safe }}"
  seoDescription: "{{ m.data.seoDescription | safe }}"
---
{%- set list = collections.team -%}
{%- set prev = list | getPreviousCollectionItem(m) -%}
{%- set next = list | getNextCollectionItem(m) -%}
<section class="station">
  <div class="wrap">
    <a class="back" href="{{ cbase }}/team.html">← Team</a>
    <div class="station__grid">
      <figure class="station__photo"><img src="{{ m.data.photo | asset }}" alt="{{ m.data.name }}"></figure>
      <div>
        <div class="glass">
          <p class="glass__top"><span>{{ m.data.role or "Announcer" }}</span><span class="lamp is-on">On air</span></p>
          <h1 class="glass__name">{{ m.data.name }}</h1>
        </div>
        <div class="copy copy--station">{{ m.content | safe }}</div>
        {% set p = { mp3: m.data.sampleMp3, ogg: m.data.sampleOgg, label: m.data.sampleLabel } %}
        {% include "concepts/dial/player.njk" %}
      </div>
    </div>
  </div>
</section>
<nav class="tunebar wrap" aria-label="More voices">
  {% if prev %}<a href="{{ cbase }}{{ prev.url }}"><small>◀ Tune down</small>{{ prev.data.cardName or prev.data.name }}</a>{% else %}<span></span>{% endif %}
  <a class="tunebar__all" href="{{ cbase }}/team.html">All voices</a>
  {% if next %}<a class="tunebar__next" href="{{ cbase }}{{ next.url }}"><small>Tune up ▶</small>{{ next.data.cardName or next.data.name }}</a>{% else %}<span></span>{% endif %}
</nav>

---
permalink: /concepts/dial/work.html
station: work
seoTitle: "Radio Ad Examples, Radio Commercial Scripts | Overnight Radio Inc."
seoDescription: "A sample of Overnight Radio spots that were created from start to finish, in a broad range of styles (Hardsell, Medium, Softsell & Creative)."
---
<section class="stationhead">
  <div class="wrap">
    <p class="readout"><span class="readout__freq">{{ (stations | findBy("key", station)).freq }}</span><span class="readout__fm">FM</span><span class="readout__now">Our Work</span></p>
    <h1 class="stationhead__title">Our Work, <span>Our Pride</span></h1>
    <p class="stationhead__lede">Overnight Radio has produced tens of thousands of top radio commercials from start to finish, covering a broad range of advertising styles from Hardsell, Medium, Softsell to Creative. Listen to some of the radio ad examples that we have produced. All made each client very happy.</p>
  </div>
</section>

<section class="panel-sec">
  <div class="wrap">
    <p class="silk">Preset buttons · filter by style</p>
    <div class="presets presets--filter" role="toolbar" aria-label="Filter by style" data-filters>
      {% for f in ["all", "Hardsell", "Medium", "Softsell", "Creative", "Sample"] %}
      <button type="button" class="preset{% if f == 'all' %} is-active{% endif %}" data-filter="{{ f }}" aria-pressed="{{ 'true' if f == 'all' else 'false' }}"><span class="preset__n">{{ loop.index }}</span><span class="preset__l">{{ "Show All" if f == "all" else f }}</span></button>
      {% endfor %}
    </div>
    <ol class="log" data-spots>
      {% for s in collections.spots %}
      <li class="spot log__row" data-category="{{ s.data.category }}">
        <a href="{{ cbase }}{{ s.url }}">
          <span class="log__n">{{ loop.index | pad2 }}</span>
          <span class="log__title">{{ s.data.title }}</span>
          <span class="log__cat log__cat--{{ s.data.category | lower }}">{{ s.data.category }}</span>
          <span class="log__go">Listen ▶</span>
        </a>
      </li>
      {% endfor %}
    </ol>
  </div>
</section>

<section class="panel-sec panel-sec--dark">
  <div class="wrap">
    <p class="silk">Listener mail</p>
    <h2 class="h2">What our <span class="hl">Clients</span> say</h2>
    <div class="letters">
      {% for t in testimonials %}
      <figure class="letter{% if t.featured %} letter--big{% endif %}">
        <blockquote>“{{ t.quote }}”</blockquote>
        {% if t.name %}<figcaption>— {{ t.name }}</figcaption>{% endif %}
      </figure>
      {% endfor %}
    </div>
  </div>
</section>

---
permalink: /concepts/dial/calculator.html
station: calculator
seoTitle: "Commercial Script Calculator | Overnight Radio Inc."
seoDescription: "Commerical Script Calculator that will calcuate the timing of the commercial."
scripts: ["/assets/js/calculator.js"]
---
<section class="stationhead">
  <div class="wrap">
    <p class="readout"><span class="readout__freq">{{ (stations | findBy("key", station)).freq }}</span><span class="readout__fm">FM</span><span class="readout__now">Script Calculator</span></p>
    <h1 class="stationhead__title">Commercial <span>Script Calculator</span></h1>
    <p class="stationhead__lede">Enter your script, select the read speed, click the button and we'll tell you how long you commercial will be.</p>
  </div>
</section>
<section class="panel-sec">
  <div class="wrap">
    <form class="timer" onsubmit="return false">
      <div class="timer__screens">
        <label class="timer__screen"><span class="silk">Script</span><textarea name="message" id="message" rows="9" placeholder="Enter script here" autofocus></textarea></label>
        <label class="timer__screen"><span class="silk">Results</span><textarea name="results" id="results" rows="9" placeholder="Results" readonly></textarea></label>
      </div>
      <div class="timer__controls">
        <label class="timer__sel"><span class="silk">Script Read Speed</span>
          <select id="speed" name="speed"><option value="1">Slow Read</option><option value="2" selected>Normal Read</option><option value="3">Fast Read</option></select>
        </label>
        <button type="button" class="pushbtn pushbtn--lit" id="calculateScript"><i></i>Calculate Length</button>
        <div class="counter"><span class="silk">Total Script Length</span><output id="wlength" name="wlength">0</output></div>
        <div class="counter"><span class="silk">Word Count</span><output id="wcount" name="wcount">0</output></div>
      </div>
    </form>
  </div>
</section>

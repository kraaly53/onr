---
pagination:
  data: collections.team
  size: 1
  alias: m
permalink: "/concepts/script/team/{{ m.fileSlug }}.html"
station: team
orderKey: "TALENT"
eleventyComputed:
  seoTitle: "{{ m.data.seoTitle | safe }}"
  seoDescription: "{{ m.data.seoDescription | safe }}"
  orderTitle: "ONE-SHEET: {{ m.data.name | safe }}"
  orderValue: "{{ (m.data.roster | upper) if m.data.roster else 'ROSTER' }}"
---
{%- set prev = collections.team | getPreviousCollectionItem(m) -%}
{%- set next = collections.team | getNextCollectionItem(m) -%}
<a class="typed-back" href="{{ cbase }}/team.html">◄ BACK TO CASTING SHEET</a>
<div class="onesheet">
  <div>
    <p class="credit__role">{{ (m.data.role or "Announcer") | upper }}</p>
    <h1 class="slug slug--big slug--name">{{ m.data.name }}</h1>
    <p class="cue">NOTES:</p>
    <div class="bio">{{ m.content | safe }}</div>
  </div>
  <a class="polaroid" href="{{ m.data.photo | asset }}" target="_blank" rel="noopener"><img src="{{ m.data.photo | asset }}" alt="{{ m.data.name }}"><span class="clip" aria-hidden="true"></span><span class="polaroid__cap">{{ m.data.name }}</span></a>
</div>
{% set p = { mp3: m.data.sampleMp3, ogg: m.data.sampleOgg, label: m.data.sampleLabel, cue: "DEMO" } %}
{% include "concepts/script/player.njk" %}
<nav class="typed-pager" aria-label="More voices">
  {% if prev %}<a href="{{ cbase }}{{ prev.url }}">◄ {{ (prev.data.cardName or prev.data.name) | upper }}</a>{% else %}<span></span>{% endif %}
  <a href="{{ cbase }}/team.html">[ ALL TALENT ]</a>
  {% if next %}<a href="{{ cbase }}{{ next.url }}">{{ (next.data.cardName or next.data.name) | upper }} ►</a>{% else %}<span></span>{% endif %}
</nav>

---
pagination:
  data: collections.posts
  size: 1
  alias: post
permalink: "/concepts/script{{ post.url }}index.html"
station: blog
orderKey: "MEMO"
eleventyComputed:
  seoTitle: "{{ post.data.title | safe }} | Overnight Radio Inc. Blog"
  seoDescription: "{{ post.data.description | safe }}"
  orderTitle: "{{ post.data.title | safe }}"
  orderValue: "{{ post.date | readableDate }}"
---
{%- set newerPost = collections.posts | getPreviousCollectionItem(post) -%}
{%- set olderPost = collections.posts | getNextCollectionItem(post) -%}
<a class="typed-back" href="{{ cbase }}/blog/">◄ ALL MEMOS</a>
<dl class="memo__head memo__head--big">
  <div><dt>DATE:</dt><dd><time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time></dd></div>
  <div><dt>FROM:</dt><dd>{{ post.data.author or "Overnight Radio" }}</dd></div>
  <div><dt>FILED:</dt><dd>{{ post.data.categories | join(", ") }}</dd></div>
  <div><dt>RE:</dt><dd><h1 class="memo__re memo__re--big">{{ post.data.title }}</h1></dd></div>
</dl>
<div class="memo__body">{{ post.content | safe }}</div>
{% if post.data.keywords and post.data.keywords.length %}<p class="note">CC: {{ post.data.keywords | join(" · ") }}</p>{% endif %}
<nav class="typed-pager" aria-label="More posts">
  {% if newerPost %}<a href="{{ cbase }}{{ newerPost.url }}">◄ NEWER: {{ newerPost.data.title | upper }}</a>{% else %}<span></span>{% endif %}
  {% if olderPost %}<a href="{{ cbase }}{{ olderPost.url }}">OLDER: {{ olderPost.data.title | upper }} ►</a>{% else %}<span></span>{% endif %}
</nav>

---
pagination:
  data: collections.posts
  size: 5
  alias: pagePosts
permalink: "{% if pagination.pageNumber == 0 %}/concepts/script/blog/index.html{% else %}/concepts/script/blog/page/{{ pagination.pageNumber + 1 }}/index.html{% endif %}"
station: blog
orderKey: "MEMOS"
eleventyComputed:
  seoTitle: "Blog{% if pagination.pageNumber > 0 %} - Page {{ pagination.pageNumber + 1 }}{% endif %} | Overnight Radio Inc."
  orderValue: "PAGE {{ pagination.pageNumber + 1 }} OF {{ pagination.pages.length }}"
---
<h1 class="slug slug--big">The Overnight Radio <mark>Blog</mark></h1>
<div class="line"><b class="who">ANNCR:</b><p class="said">We will be discussing issues relevant to the world of radio production and scripting.</p></div>
{% for post in pagePosts %}
<section class="memo">
  <dl class="memo__head">
    <div><dt>DATE:</dt><dd><time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time></dd></div>
    <div><dt>FROM:</dt><dd>{{ post.data.author or "Overnight Radio" }}</dd></div>
    <div><dt>FILED:</dt><dd>{{ post.data.categories | join(", ") }}</dd></div>
    <div><dt>RE:</dt><dd><h2 class="memo__re"><a href="{{ cbase }}{{ post.url }}">{{ post.data.title }}</a></h2></dd></div>
  </dl>
  <p>{{ post.content | excerpt }}</p>
  <a class="typed-btn" href="{{ cbase }}{{ post.url }}">[ CONTINUE READING ]</a>
</section>
{% endfor %}
<nav class="typed-pager" aria-label="Blog pages">
  {% if pagination.href.previous %}<a href="{{ pagination.href.previous }}" rel="prev">◄ NEWER POSTS</a>{% else %}<span class="is-off">◄ NEWER POSTS</span>{% endif %}
  <span>PAGE {{ pagination.pageNumber + 1 }} OF {{ pagination.pages.length }}</span>
  {% if pagination.href.next %}<a href="{{ pagination.href.next }}" rel="next">OLDER POSTS ►</a>{% else %}<span class="is-off">OLDER POSTS ►</span>{% endif %}
</nav>

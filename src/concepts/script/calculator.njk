<h1 class="slug slug--big">Commercial <mark>Script Calculator</mark></h1>
<div class="line"><b class="who">ANNCR:</b><p class="said">Enter your script, select the read speed, click the button and we'll tell you how long you commercial will be.</p></div>
<form class="typewriter" onsubmit="return false">
  <label class="cue" for="message">SCRIPT:</label>
  <textarea class="lined" name="message" id="message" rows="9" placeholder="Enter script here" autofocus></textarea>
  <div class="typewriter__row">
    <label class="fillin"><span>SCRIPT READ SPEED:</span>
      <select id="speed" name="speed"><option value="1">Slow Read</option><option value="2" selected>Normal Read</option><option value="3">Fast Read</option></select>
    </label>
    <button type="button" class="typed-btn typed-btn--big" id="calculateScript">[ CALCULATE LENGTH ]</button>
  </div>
  <div class="typewriter__out">
    <div class="stampbox"><span class="cue">TOTAL SCRIPT LENGTH:</span><output class="stamp stamp--big" id="wlength" name="wlength">0</output></div>
    <div class="stampbox"><span class="cue">WORD COUNT:</span><output class="stamp stamp--big stamp--blue" id="wcount" name="wcount">0</output></div>
  </div>
  <label class="cue" for="results">RESULTS (AS READ):</label>
  <textarea class="lined lined--out" name="results" id="results" rows="6" placeholder="Results" readonly></textarea>
</form>

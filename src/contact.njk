---
layout: base.njk
permalink: /contact.html
seoTitle: "Contact | Overnight Radio Inc."
seoDescription: "Independent production house for GREAT Radio Commercials, Jingles & Ads the very next day!"
eyebrow: Contact
heading: "We’d like to hear <strong>from you!</strong>"
lede: "We like to create things with people. Feel free to say hello!."
---
{% include "page-head.njk" %}

<section class="section section--paper section--flush-top">
  <div class="wrap contact">
    <form class="form" method="post" action="{{ site.contactEndpoint }}" data-contact data-unit-tag="wpcf7-f{{ site.contactFormId }}-o1">
      <label>Your name <input type="text" name="your-name" autocomplete="name" placeholder="Put your name here" required maxlength="400"></label>
      <label>Your email <input type="email" name="your-email" autocomplete="email" placeholder="Your email in this box" required maxlength="400"></label>
      <label>Your message (optional) <textarea name="your-message" rows="6" maxlength="2000" placeholder="And your message right here"></textarea></label>
      <label class="hp" aria-hidden="true">Please leave this field empty. <input type="text" name="honeypot-22" tabindex="-1" autocomplete="off"></label>
      <button class="btn btn--amber" type="submit">Send</button>
      <p class="form__status" data-status role="status" hidden></p>
    </form>
    <aside class="contact__card">
      <h2>{{ site.name }}</h2>
      <p><svg aria-hidden="true"><use href="#i-pin"/></svg> {{ site.city }}</p>
      <p><svg aria-hidden="true"><use href="#i-phone"/></svg> <a href="{{ site.phoneHref }}">{{ site.phone }}</a></p>
      <p><svg aria-hidden="true"><use href="#i-mail"/></svg> <a href="mailto:{{ site.email }}?subject=Website%20Inquiry">{{ site.email }}</a></p>
      <ul class="social social--ink">
        {% for s in site.social %}<li><a href="{{ s.url }}" target="_blank" rel="noopener" aria-label="{{ s.name }}"><svg aria-hidden="true"><use href="#i-{{ s.icon }}"/></svg></a></li>{% endfor %}
      </ul>
    </aside>
  </div>
</section>

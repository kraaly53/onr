---
layout: base.njk
permalink: /work.html
seoTitle: "Radio Ad Examples, Radio Commercial Scripts | Overnight Radio Inc."
seoDescription: "A sample of Overnight Radio spots that were created from start to finish, in a broad range of styles (Hardsell, Medium, Softsell & Creative)."
eyebrow: Our Work
heading: "Our Work, <strong>Our Pride</strong>"
lede: "Overnight Radio has produced tens of thousands of top radio commercials from start to finish, covering a broad range of advertising styles from Hardsell, Medium, Softsell to Creative. Listen to some of the radio ad examples that we have produced. All made each client very happy."
---
{% include "page-head.njk" %}

<section class="section section--paper section--flush-top">
  <div class="wrap">
    <div class="filters" role="toolbar" aria-label="Filter by style" data-filters>
      {% for f in ["all", "Hardsell", "Medium", "Softsell", "Creative", "Sample"] %}
      <button type="button" class="chip{% if f == 'all' %} is-active{% endif %}" data-filter="{{ f }}" aria-pressed="{{ 'true' if f == 'all' else 'false' }}">{{ "Show All" if f == "all" else f }}</button>
      {% endfor %}
    </div>
    <ul class="spots" data-spots>
      {% for s in collections.spots %}
      <li class="spot spot--{{ s.data.category | lower }}" data-category="{{ s.data.category }}">
        <a href="{{ s.url }}">
          <span class="spot__top"><span class="tag">{{ s.data.category }}</span><span class="spot__go"><svg aria-hidden="true"><use href="#i-play"/></svg></span></span>
          <span class="spot__title">{{ s.data.title }}</span>
          <span class="spot__wave" aria-hidden="true"></span>
        </a>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>

<section class="section section--night">
  <div class="wrap">
    <p class="eyebrow">Testimonials</p>
    <h2 class="h2">What our <strong>Clients</strong> say</h2>
    <div class="quotes">
      {% for t in testimonials %}
      <figure class="quote{% if t.featured %} quote--featured{% endif %}">
        <blockquote>“{{ t.quote }}”</blockquote>
        {% if t.name %}<figcaption>{{ t.name }}</figcaption>{% endif %}
      </figure>
      {% endfor %}
    </div>
  </div>
</section>

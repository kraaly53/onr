<article class="postcard">
  <p class="postmeta">
    <time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>
    {% for c in post.data.categories %}<a class="tag" href="/blog/category/{{ c | slug }}/">{{ c }}</a>{% endfor %}
  </p>
  <h2 class="postcard__title"><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
  <p class="postcard__excerpt">{{ post.content | excerpt }}</p>
  <a class="textlink" href="{{ post.url }}">Continue reading <span class="sr-only">{{ post.data.title }}</span><svg aria-hidden="true"><use href="#i-arrow-right"/></svg></a>
</article>

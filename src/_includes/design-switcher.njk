{# Preview-only: lets you flip between design versions. Turn off with "designSwitcher": false in site.json. #}
<div class="dswitch" data-dswitch>
  <button class="dswitch__toggle" type="button" aria-expanded="true" data-dswitch-toggle>
    <span class="dswitch__dot"></span><span>Design</span> <b data-dswitch-current></b>
  </button>
  <div class="dswitch__panel" role="radiogroup" aria-label="Choose a design">
    {% for d in site.designs %}
    <button type="button" role="radio" data-design-pick="{{ d.id }}">
      <span class="dswitch__id">{{ d.id | upper }}</span>
      <span class="dswitch__txt"><strong>{{ d.name }}</strong><small>{{ d.note }}</small></span>
    </button>
    {% endfor %}
    <button type="button" class="dswitch__link" data-dswitch-copy>Copy link to this design</button>
  </div>
</div>

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ seoTitle or title }}</title>
  <meta name="description" content="{{ seoDescription or description }}">
  <meta name="robots" content="noindex">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/concepts/session.css">
  <link rel="stylesheet" href="/assets/css/designs/switcher.css">
</head>
{%- set here = markers | findBy("key", station) or markers[0] -%}
{%- set idx = 0 -%}{%- for mk in markers %}{% if mk.key == here.key %}{% set idx = loop.index0 %}{% endif %}{% endfor -%}
{%- set prevM = markers[idx - 1] if idx > 0 else markers[markers.length - 1] -%}
{%- set nextM = markers[idx + 1] if idx < markers.length - 1 else markers[0] -%}
<body style="--track: {{ here.color }}">
  {% include "icons.njk" %}
  <a class="skip" href="#main">Skip to content</a>

  <header class="daw">
    <div class="transport">
      <a class="transport__brand" href="{{ cbase }}/index.html">{% include "mark.njk" %}<span><b>Overnight Radio</b><small>Session · {{ site.city }}</small></span></a>
      <div class="transport__btns">
        <a class="tbtn" href="{{ cbase }}{{ prevM.path }}" title="Previous marker: {{ prevM.label }}" aria-label="Previous page: {{ prevM.label }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5h2v14H6zM20 5v14L9 12z" fill="currentColor"/></svg></a>
        <button class="tbtn tbtn--play" type="button" data-transport-play title="Play the sample spot" aria-label="Play the sample spot">
          <svg class="tp-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5v14l12-7z" fill="currentColor"/></svg>
          <svg class="tp-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5h4v14H6zM14 5h4v14h-4z" fill="currentColor"/></svg>
        </button>
        <a class="tbtn" href="{{ cbase }}{{ nextM.path }}" title="Next marker: {{ nextM.label }}" aria-label="Next page: {{ nextM.label }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 5h2v14h-2zM4 5v14l11-7z" fill="currentColor"/></svg></a>
        <span class="tbtn tbtn--rec" aria-hidden="true" title="Recording since 1998"><i></i></span>
      </div>
      <div class="lcd" aria-hidden="true">
        <span class="lcd__time" data-timecode>00:00:00:00</span>
        <span class="lcd__meta"><b>120</b> BPM · 4/4 · <span>{{ here.label }}</span></span>
      </div>
      <button class="nav-toggle transport__menu" aria-expanded="false" aria-controls="markers"><span class="sr-only">Menu</span>Markers</button>
    </div>
    <nav id="markers" class="ruler nav" aria-label="Main">
      <ol>
        {% for mk in markers %}
        <li style="--c: {{ mk.color }}"><a href="{{ cbase }}{{ mk.path }}"{% if mk.key == here.key %} aria-current="page"{% endif %}><span class="ruler__bar">{{ loop.index }}</span><span class="ruler__label">{{ mk.label }}</span></a></li>
        {% endfor %}
      </ol>
    </nav>
  </header>

  <main id="main" class="arrange">
    {{ content | safe }}
  </main>

  <footer class="bus">
    <div class="bus__row">
      <div class="bus__ch"><span class="bus__name">Master</span><span class="bus__val">{{ site.name }}</span></div>
      <div class="bus__ch"><span class="bus__name">Phone</span><a class="bus__val" href="{{ site.phoneHref }}">{{ site.phone }}</a></div>
      <div class="bus__ch"><span class="bus__name">Email</span><a class="bus__val" href="mailto:{{ site.email }}">{{ site.email }}</a></div>
      <div class="bus__ch"><span class="bus__name">Location</span><span class="bus__val">{{ site.city }}</span></div>
      <div class="bus__ch bus__ch--out">
        <span class="bus__name">Sends</span>
        <span class="bus__sends">{% for s in site.social %}<a href="{{ s.url }}" target="_blank" rel="noopener" aria-label="{{ s.name }}"><svg aria-hidden="true"><use href="#i-{{ s.icon }}"/></svg></a>{% endfor %}</span>
      </div>
      <a class="bbb" href="{{ site.bbbUrl }}" target="_blank" rel="noopener"><img src="{{ site.bbbImage }}" height="57" alt="Overnight Radio Inc., Radio Program Producers, London, ON"></a>
    </div>
    <p class="bus__legal">&copy; Copyright. All rights reserved. {{ site.legalName }} · <a href="{{ cbase }}/privacypolicy.html">Privacy Policy</a></p>
  </footer>

  {%- set sample = collections.spots | first -%}
  <audio data-transport-audio preload="none" src="{{ sample.data.spotMp3 | asset }}"></audio>

  {% if site.designSwitcher %}{% include "design-switcher.njk" %}<script src="/assets/js/design-switcher.js" defer></script>{% endif %}
  <script src="/assets/js/site.js" defer></script>
  <script src="/assets/concepts/session.js" defer></script>
  {% if scripts %}{% for s in scripts %}<script src="{{ s }}" defer></script>{% endfor %}{% endif %}
</body>
</html>

{# Audio as an editable clip: a big waveform with a playhead. Same hooks as the main player (site.js). #}
<div class="clip-ed" data-player>
  <div class="clip-ed__head">
    <button class="player__btn clip-ed__btn" type="button" aria-label="Play {{ p.label }}">
      <svg class="player__play" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5v14l12-7z" fill="currentColor"/></svg>
      <svg class="player__pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5h4v14H6zM14 5h4v14h-4z" fill="currentColor"/></svg>
    </button>
    <span class="clip-ed__name">{{ p.label }}</span>
    <span class="clip-ed__time"><span data-cur>0:00</span> / <span data-dur>–:––</span></span>
  </div>
  <div class="player__body clip-ed__body">
    <div class="clip-ed__wave" data-track role="slider" tabindex="0" aria-label="Seek" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
      <svg class="clip-ed__svg" viewBox="0 0 400 80" preserveAspectRatio="none" aria-hidden="true">
        <path d="{% for n in range(0, 200) %}{% set a = ((((n * 7919) % 97) / 97) * 0.55 + 0.25) * (0.55 + 0.45 * (((n * 31) % 13) / 13)) %}M{{ n * 2 + 1 }} {{ (40 - a * 36) | round(1) }}V{{ (40 + a * 36) | round(1) }}{% endfor %}" stroke="currentColor" stroke-width="1.3"/>
      </svg>
      <span class="clip-ed__played" data-fill aria-hidden="true"></span>
      <span class="clip-ed__head-line" aria-hidden="true"></span>
    </div>
  </div>
  <audio preload="metadata" controls>
    <source src="{{ p.mp3 | asset }}" type="audio/mpeg">
    {% if p.ogg %}<source src="{{ p.ogg | asset }}" type="audio/ogg">{% endif %}
  </audio>
</div>

{# Pill player with a waveform. Same hooks as the main player (site.js). #}
<div class="pill-player" data-player>
  <button class="player__btn pp__btn" type="button" aria-label="Play {{ p.label }}">
    <svg class="player__play" aria-hidden="true"><use href="#i-play"/></svg>
    <svg class="player__pause" aria-hidden="true"><use href="#i-pause"/></svg>
  </button>
  <div class="player__body pp__body">
    <div class="pp__meta"><span class="pp__label">{{ p.label }}</span><span class="pp__time"><span data-cur>0:00</span> / <span data-dur>–:––</span></span></div>
    <div class="pp__wave" data-track role="slider" tabindex="0" aria-label="Seek" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
      <span class="pp__bars" aria-hidden="true">{% for n in range(0, 56) %}<i style="--h: {{ (((n * 37) % 23) + 6) * 3 + (0 if n % 5 else 12) }}%"></i>{% endfor %}</span>
      <span class="pp__bars pp__bars--on" data-fill aria-hidden="true">{% for n in range(0, 56) %}<i style="--h: {{ (((n * 37) % 23) + 6) * 3 + (0 if n % 5 else 12) }}%"></i>{% endfor %}</span>
    </div>
  </div>
  <audio preload="metadata" controls>
    <source src="{{ p.mp3 | asset }}" type="audio/mpeg">
    {% if p.ogg %}<source src="{{ p.ogg | asset }}" type="audio/ogg">{% endif %}
  </audio>
</div>

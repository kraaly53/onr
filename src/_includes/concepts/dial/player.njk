{# Receiver-style player. Same hooks as the main player (site.js): data-player, .player__btn, data-track, data-fill, data-cur, data-dur #}
<div class="deck" data-player>
  <button class="player__btn deck__play" type="button" aria-label="Play {{ p.label }}">
    <svg class="player__play" aria-hidden="true"><use href="#i-play"/></svg>
    <svg class="player__pause" aria-hidden="true"><use href="#i-pause"/></svg>
    <span class="deck__led" aria-hidden="true"></span>
  </button>
  <div class="player__body deck__body">
    <div class="deck__meta"><span class="deck__label">{{ p.label }}</span><span class="deck__time"><span data-cur>0:00</span> / <span data-dur>–:––</span></span></div>
    <div class="deck__scale" data-track role="slider" tabindex="0" aria-label="Seek" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
      {% for n in range(0, 41) %}<i{% if n % 5 == 0 %} class="major"{% endif %}></i>{% endfor %}
      <span class="deck__needle" data-fill aria-hidden="true"></span>
    </div>
  </div>
  <div class="vu-pair" aria-hidden="true"><span class="vu-m"><b>L</b><i></i></span><span class="vu-m"><b>R</b><i></i></span></div>
  <audio preload="metadata" controls>
    <source src="{{ p.mp3 | asset }}" type="audio/mpeg">
    {% if p.ogg %}<source src="{{ p.ogg | asset }}" type="audio/ogg">{% endif %}
  </audio>
</div>

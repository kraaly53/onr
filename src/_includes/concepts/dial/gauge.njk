{# Analog VU-style meter. g = { k, v, sub, angle } #}
<figure class="gauge" style="--a: {{ g.angle }}deg">
  <div class="gauge__face" aria-hidden="true">
    <svg viewBox="0 0 200 110">
      <path d="M20 100 A80 80 0 0 1 180 100" fill="none" stroke="currentColor" stroke-width="1.5" opacity=".5"/>
      <path d="M140 31 A80 80 0 0 1 180 100" fill="none" stroke="#ff3b30" stroke-width="5"/>
      {% for t in range(0, 11) %}{% set ang = (-80 + t * 16) %}<line x1="100" y1="22" x2="100" y2="{{ 32 if t % 5 == 0 else 28 }}" stroke="currentColor" stroke-width="1.5" transform="rotate({{ ang }} 100 100)"/>{% endfor %}
      <text x="22" y="90">-20</text><text x="92" y="48">0</text><text x="166" y="90">+3</text>
    </svg>
    <span class="gauge__needle"></span>
    <span class="gauge__vu">VU</span>
  </div>
  <figcaption><span class="gauge__k">{{ g.k }}</span><span class="gauge__v">{{ g.v }}</span>{% if g.sub %}<span class="gauge__k">{{ g.sub }}</span>{% endif %}</figcaption>
</figure>

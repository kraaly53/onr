{# Horizon player: a little sun travels along the horizon as the sample plays. Same hooks as the main player. #}
<div class="horizon" data-player>
  <button class="player__btn horizon__btn" type="button" aria-label="Play {{ p.label }}">
    <svg class="player__play" aria-hidden="true"><use href="#i-play"/></svg>
    <svg class="player__pause" aria-hidden="true"><use href="#i-pause"/></svg>
  </button>
  <div class="player__body horizon__body">
    <div class="horizon__meta"><span>{{ p.label }}</span><span><span data-cur>0:00</span> / <span data-dur>–:––</span></span></div>
    <div class="horizon__line" data-track role="slider" tabindex="0" aria-label="Seek" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
      <span class="horizon__glow" data-fill aria-hidden="true"></span>
    </div>
  </div>
  <audio preload="metadata" controls>
    <source src="{{ p.mp3 | asset }}" type="audio/mpeg">
    {% if p.ogg %}<source src="{{ p.ogg | asset }}" type="audio/ogg">{% endif %}
  </audio>
</div>

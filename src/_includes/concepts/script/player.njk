{# Typed "tape" player. Same hooks as the main player (site.js) plus a text progress bar (data-bar). #}
<div class="tape" data-player>
  <p class="tape__cue"><b>{{ p.cue or "SFX" }}:</b> <span>{{ p.label | upper }}</span></p>
  <button class="player__btn tape__btn" type="button" aria-label="Play {{ p.label }}">
    <span class="player__play">[ ▶ PLAY TAPE ]</span><span class="player__pause">[ ❚❚ PAUSE ]</span>
  </button>
  <div class="player__body tape__body">
    <span class="tape__track" data-track role="slider" tabindex="0" aria-label="Seek" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span data-bar="28" aria-hidden="true"></span><span data-fill hidden></span></span>
    <span class="tape__time"><span data-cur>0:00</span>/<span data-dur>–:––</span></span>
  </div>
  <audio preload="metadata" controls>
    <source src="{{ p.mp3 | asset }}" type="audio/mpeg">
    {% if p.ogg %}<source src="{{ p.ogg | asset }}" type="audio/ogg">{% endif %}
  </audio>
</div>

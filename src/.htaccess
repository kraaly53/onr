# Overnight Radio site: caching rules.
# Pages change on every deploy, so ask browsers and caches to check for a fresh copy each time.
# CSS and JS links carry a ?v=<build> version, so those can be cached for a long time safely.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|json|xml)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
